{
  "expo": {
    "name": "AgapePlay Tandem",
    "slug": "agapeplay-tandem",
    "version": "0.2.2",
    "orientation": "portrait",
    "scheme": "agapeplay",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agapeplay.tandem",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:tandem.agapeplay.store"
      ],
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.agapeplay.tandem",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tandem.agapeplay.store",
              "path": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1c3241"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1C2B4A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6d358e4-f5c1-4acd-987f-2baaed8678fc"
      }
    },
    "owner": "nitch8190",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
