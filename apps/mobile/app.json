{
  "expo": {
    "name": "AgapePlay Tandem",
    "slug": "agapeplay-tandem",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "agapeplay",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agapeplay.tandem",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:tandem.agapeplay.store"
      ]
    },
    "android": {
      "package": "com.agapeplay.tandem",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tandem.agapeplay.store",
              "path": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6d358e4-f5c1-4acd-987f-2baaed8678fc"
      }
    },
    "owner": "nitch8190"
  }
}
