{
  "name": "agapeplay-tandem",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "preview": "npm --workspace apps/web run preview",
    "mobile:start": "npm --workspace apps/mobile run start",
    "mobile:typecheck": "npm --workspace apps/mobile run typecheck",
    "mobile:export": "npm --workspace apps/mobile run export:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "lint": "eslint .",
    "smoke:web": "node scripts/fumee-web.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/pg": "^8.20.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "pg": "^8.22.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10"
  }
}
